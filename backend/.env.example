# Copie este arquivo para backend/.env e ajuste os valores locais.
# O arquivo .env NUNCA deve ser enviado ao GitHub.
NODE_ENV=development
PORT=3001

# PostgreSQL local (banco de desenvolvimento e banco de testes)
DATABASE_URL=postgres://frotamax:frotamax@localhost:5432/frotamax
DATABASE_URL_TEST=postgres://frotamax:frotamax@localhost:5432/frotamax_test

# Gere um segredo próprio com pelo menos 32 caracteres, por exemplo:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque-por-um-segredo-local-com-pelo-menos-32-caracteres
JWT_EXPIRES_IN=8h

# Endereço do front-end autorizado a consumir a API
CORS_ORIGIN=http://localhost:3000

# Senha dos usuários FICTÍCIOS de demonstração criados por "npm run db:seed".
# Use uma senha local qualquer (mínimo de 8 caracteres); não reutilize senhas reais.
SEED_SENHA=defina-uma-senha-local
